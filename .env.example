# =============================================================================
# Хосият Кафе — демо-версия (неофициальная)
#
# Локально:
#   Windows:  copy .env.example .env.local
#   macOS/Linux:  cp .env.example .env.local
#
# Демо НЕ подключает Supabase Ahmad Cafe.
# Не добавляйте реальные секреты и не публикуйте сайт без разрешения.
# =============================================================================

# --- Сайт ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Контактный телефон (только отображение; заказы в демо отключены) ---
# Только цифры, код страны без +
NEXT_PUBLIC_WHATSAPP_NUMBER=992988099658

# --- Supabase (НЕ использовать для публичного демо Khosiyat) ---
# Оставьте пустыми / закомментированными в демо-режиме.
# В будущем — отдельный проект Supabase для Хосият, не Ahmad.
#
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
